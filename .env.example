# Copy to .env.local for local development. In production, set these in Vercel → Settings → Environment Variables.
# Only variables starting with NEXT_PUBLIC_ are visible in the browser. Never put a secret in one.

# Your live address, no trailing slash. Used for canonical URLs, sitemap and social tags.
NEXT_PUBLIC_SITE_URL=https://wetheapex.com

# Contact form (Resend). CONTACT_FROM_EMAIL must be on a domain you have verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Chatbot. Leave empty to use the built-in rule-based answers.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# Analytics. Set one, both or neither. Scripts load only after the visitor accepts.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
